{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Sync PramodDutta Repository",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\scripts\\sync_pramod_content.ps1"
